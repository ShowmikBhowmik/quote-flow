{
  "name": "quote-flow",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production,pages && cp dist/quote-flow/browser/index.html dist/quote-flow/browser/404.html",
    "preview": "npx http-server dist/quote-flow/browser -p 4300 -c-1 --proxy \"http://localhost:4300?\"",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "tsc -p tsconfig.app.json --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
